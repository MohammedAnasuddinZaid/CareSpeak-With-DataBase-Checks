{
  "name": "carespeak-ai",
  "version": "2.0.0",
  "description": "AI-powered assistive communication for patients who cannot speak or move easily — gestures, eyes and IoT vitals to speech and clinician alerts.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/reset.ts && tsx db/migrate.ts && tsx db/seed.ts",
    "db:studio": "tsx db/verify.ts",
    "db:verify:audit": "tsx scripts/verify-audit.ts",
    "user:create": "tsx scripts/create-user.ts",
    "smtp:probe": "tsx scripts/smtp-probe.ts",
    "typecheck": "tsc --noEmit",
    "db:repair:audit": "tsx scripts/repair-audit-chain.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "@upstash/redis": "^1.34.3",
    "framer-motion": "^12.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.23.0",
    "mysql2": "^3.24.4",
    "next": "^15.5.26",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
