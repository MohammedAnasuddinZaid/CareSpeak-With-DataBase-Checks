# ---------------------------------------------------------------------------
# CareSpeak environment
# Copy to `.env.local` for local development (gitignored).
# For deployment set the same keys in your host's environment settings.
# ---------------------------------------------------------------------------

# --- Database (system of record) --------------------------------------------
# Local MySQL 8. For a hosted deployment point this at a managed MySQL
# (Aiven / TiDB Cloud / PlanetScale) and the app code is unchanged.
DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/carespeak
# Pool sizing. Raise `DATABASE_POOL_MAX` when you run more app instances than
# MySQL's max_connections can serve; keep (instances x pool_max) < max_connections.
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Redis (cache + realtime fan-out bus) ------------------------------------
# Works with local Redis, Upstash, Aiven, Railway, ElastiCache — same ioredis
# code path, only the URL changes. Leave REDIS_URL empty to run on the built-in
# in-memory bus (single instance only; fine for local dev).
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=cs

# --- Auth --------------------------------------------------------------------
# 32+ random bytes. Signs session cookies and encrypts TOTP secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Pepper mixed into every password/OTP hash. Rotating it invalidates all hashes.
AUTH_PEPPER=
ACCESS_TOKEN_TTL=900         # 15 min
REFRESH_TOKEN_TTL=2592000    # 30 days
OTP_TTL=600                  # 10 min
OTP_MAX_ATTEMPTS=5
# scrypt cost. Raise on real hardware; 16384 is ~100ms on a modern laptop.
SCRYPT_COST=16384

# --- Google Sign-In (OAuth 2.0 + PKCE) ---------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outbound email (Gmail SMTP) ---------------------------------------------
# Account password goes nowhere near this app. Use an App Password instead:
# Google Account -> Security -> 2-Step Verification -> App passwords.
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"  (16 chars)
# 16 chars, no spaces: xxxxxxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mohdanasuddin555@gmail.com
SMTP_APP_PASSWORD=
MAIL_FROM="CareSpeak <carespeak@yourdomain.com>"
MAIL_FROM_NAME=CareSpeak

# --- IoT ---------------------------------------------------------------------
# Must match DEVICE_TOKEN in firmware/carespeak_esp32.ino. When empty the
# /api/ingest endpoint stays open for demos — never leave it empty in a
# deployment reachable from the internet.
CARESPEAK_DEVICE_TOKEN=

# --- Deployment --------------------------------------------------------------
# Public origin, used to build QR pairing links and absolute URLs in email.
# http://localhost:3000 for development.
APP_ORIGIN=http://localhost:3000
